{
  "name": "mcp-apps-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "ci": "pnpm run codegen && pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "dev": "pnpm -F @quiz/server dev",
    "test": "pnpm -r test",
    "test:ci": "pnpm --filter @quiz/core --filter @quiz/ui test:ci",
    "test:coverage": "pnpm --filter @quiz/core --filter @quiz/ui test:coverage",
    "lint": "biome check .",
    "lint:ci": "biome check . --reporter=github",
    "typecheck": "pnpm -r typecheck",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "format": "biome format --write .",
    "codegen": "pnpm -F @quiz/server codegen && pnpm -F @quiz/ui codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "@biomejs/biome"]
  }
}
